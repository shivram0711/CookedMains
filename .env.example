# Cooked Mains AI — Environment Variables
# Copy this file to .env and fill in your actual Gemini API key.

# Your Google Gemini API Key (Required for answer evaluation)
GEMINI_API_KEY=your_gemini_api_key_here

# Persistent storage directory (Optional: leave empty for local folder)
DATA_DIR=

# Admin dashboard master password
ADMIN_PASSWORD=admin123

# Server Port (Defaults to 8000)
PORT=8000
